{
  "name": "violet-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node scripts/server.mjs",
    "test:server": "node scripts/server.mjs test ./...",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests *.ts *.json *.md index.html",
    "format:check": "prettier --check src scripts tests *.ts *.json *.md index.html",
    "db:schema": "node scripts/export-schema.mjs"
  },
  "dependencies": {
    "motion": "^13.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "description": "紫羅蘭永恆花園介紹網站與花園信箱，使用 React、TypeScript、Go 與 MySQL",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
